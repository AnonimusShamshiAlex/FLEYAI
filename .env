# FLEY AI - настройки. Файл .env должен лежать рядом с FLEY AI.exe
# Подходит ключ Groq (gsk_...), OpenRouter (sk-or-...) или OpenAI (sk-...), тип определяется автоматически.
GROQ_API_KEY=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

# Groq по умолчанию: whisper-large-v3 + openai/gpt-oss-120b + голос Windows (бесплатно).
# FLEY_MODEL=openai/gpt-oss-120b
# FLEY_STT_MODEL=whisper-large-v3-turbo
# Озвучка: windows (по умолчанию для Groq) или модель API, например gpt-4o-mini-tts (OpenAI/OpenRouter)
# FLEY_TTS_MODEL=windows
# Голос для облачной озвучки (onyx, echo, ...)
FLEY_VOICE=onyx
# Управление компьютером голосом (открыть программу, YouTube, файлы, громкость...): 1 = включено, 0 = только разговор
FLEY_PC_CONTROL=1
# Сколько секунд тишины после фразы считать концом речи (0.4-5). Микрофон слушает постоянно, нажимать ничего не нужно
FLEY_SILENCE_SECONDS=1.2
# Глубина размышлений модели gpt-oss: low (быстро, по умолчанию), medium, high (долго думает)
FLEY_REASONING=low
# Голос Windows: часть имени установленного голоса (например Pavel для русского, George или Ryan для английского).
# Пусто = любой мужской голос нужного языка.
FLEY_WINDOWS_VOICE=
# Высота голоса: 0.5-1.5 (меньше = ниже и глубже, 0.85 по умолчанию) и скорость: 0.5-2.5
FLEY_VOICE_PITCH=0.96
FLEY_VOICE_RATE=1.0
# Как обращаться к вам, например: сэр
FLEY_CALL_ME=
# Чувствительность микрофона: 0 = авто. Если шум фона мешает, поставьте 800-1500
FLEY_VOICE_THRESHOLD=0

# 0 = не спрашивать подтверждение для опасных действий (по умолчанию). 1 = спрашивать окном Да/Нет
FLEY_CONFIRM=0
# Голос: 1 = JARVIS (мягкий, чистый), 2 = робот (металл), 0 = без эффектов
FLEY_VOICE_FX=1
# Режим окна: full (весь экран), window (окно), mini (маленькое окно поверх всех)
FLEY_WINDOW_MODE=full

# Слово-активатор: FLEY отвечает только на фразы со словом (например флей), потом 25 с слушает без него. Пусто = отвечать на всё
# FLEY_WAKE=флей
# Запуск вместе с Windows: 1 = да
# FLEY_AUTOSTART=0

# Язык распознавания речи: ru, en, uz ... или auto (определять самому). Явный язык заметно точнее.
FLEY_STT_LANG=ru

# Голос как у JARVIS (нейросеть OpenAI). Вставьте СВОЙ ключ OpenAI (sk-...), и озвучка станет живой.
# Чат и распознавание остаются на Groq. Если ключ пустой, говорит голос Windows. Ответ стоит копейки.
# Голоса: ash, onyx, echo, ballad, sage, verse... (FLEY_VOICE=ash по умолчанию)
FLEY_TTS_API_KEY=

# Усиление микрофона (1 = выключено). Для речи с расстояния 3-5 метров 4-8, автоусиление поднимет само. Слишком много = ловит шум.
FLEY_MIC_GAIN=2

# Шумоподавление записи (1 = вкл, по умолчанию выкл: Whisper и сам хорошо переносит шум). Помогает, когда говорите издалека и в комнате шумно.
FLEY_DENOISE=0

# Какой микрофон использовать: часть его названия (например USB или Realtek). Пусто = микрофон Windows по умолчанию.
# Список найденных микрофонов пишется в файл fley.log.
FLEY_MIC_DEVICE=

# Приветствие при запуске (1 = говорить, 0 = молча)
FLEY_GREETING=1

# Боковая панель «МОНИТОР» (F2): 1 = показывать
FLEY_SIDE_PANEL=0

# Озвучивать ответы на команды, введённые текстом (1 = да, 0 = только текст)
FLEY_SPEAK_TYPED=0

# Зрение: ИИ видит экран (снимок -> модель с картинками). Для Groq по умолчанию qwen/qwen3.8-27b, для OpenAI gpt-4o-mini.
# Если модель сняли с производства, программа сама попробует запасные; свою можно указать тут.
# FLEY_VISION_MODEL=qwen/qwen3.8-27b
# 1 = перед каждым ответом смотреть на экран (кнопка ЗРЕНИЕ в верхней панели переключает это же)
FLEY_SCREEN_AWARE=0
